yaml
name: Run BSJP Screener Cron

on:
  schedule:
    # Berjalan setiap Senin - Jumat pukul 08:45 UTC (sama dengan 15:45 WIB)
    - cron: '45 8 * * 1-5'
  workflow_dispatch: # Tombol manual agar bisa Anda jalankan kapan saja dari tablet via web GitHub

jobs:
  run-screener:
    runs-on: ubuntu-latest

    steps:
    - name: Check out repository code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install yfinance pandas requests

    - name: Run BSJP Screener Script
      run: |
        python screener_bsjp.py

    - name: Get Current Date
      id: date
      run: echo "date=$(date +'%Y-%m-%d')" >> $GITHUB_OUTPUT

    - name: Upload Hasil ke GitHub Release (Mudah di-download via Tablet)
      uses: softprops/action-gh-release@v2
      with:
        tag_name: BSJP-${{ steps.date.outputs.date }}
        name: Hasil Screener BSJP ${{ steps.date.outputs.date }}
        body: |
          Hasil pemindaian saham BSJP otomatis untuk tanggal ${{ steps.date.outputs.date }}.
          Silakan unduh file CSV di bawah ini dan buka menggunakan Google Sheets / Microsoft Excel di tablet Anda.
        files: |
          hasil_bsjp_*.csv
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
